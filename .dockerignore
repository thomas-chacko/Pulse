# .dockerignore - tells Docker what files to ignore when building
# This makes your Docker image smaller and builds faster

# Node modules (we'll install them fresh in the container)
node_modules/
npm-debug.log

# Environment files (never copy secrets into images!)
.env
.env.local
.env.*.local

# Git files
.git/
.gitignore
.github/

# Documentation
README.md
*.md

# Test files
test/
tests/
**/*.test.js
**/*.spec.js
coverage/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Database files (if you have local db files)
db/*.db
*.sqlite
*.sqlite3
