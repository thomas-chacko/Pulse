# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Application Settings
NODE_ENV=development
PORT=3000

# Security — API Key Authentication
# Generate a strong key: node -e "console.log(require('crypto').randomUUID())"
# Leave empty to disable authentication (not recommended for production)
API_KEY=your_secret_private_key

# CORS — Allowed Origins (comma-separated, production only)
# If not set, all origins are allowed
# ALLOWED_ORIGINS=https://your-app.com,https://claude.ai

# Database Connection
MONGODB_URI=your_mongodb_connection_string

# Personal GitHub Account
GITHUB_PERSONAL_TOKEN=ghp_your_personal_token_here
GITHUB_PERSONAL_USERNAME=your_personal_username

# Company GitHub Account
GITHUB_COMPANY_TOKEN=ghp_your_company_token_here
GITHUB_COMPANY_USERNAME=your_company_username

# Google Calendar (Coming Soon)